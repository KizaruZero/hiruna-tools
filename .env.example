# Copy to .env and adjust. All values are optional — the app runs with defaults.
# Server
HOST=127.0.0.1
PORT=8000

# Storage / jobs
DATA_DIR=~/.media-tools
FILE_RETENTION_HOURS=2
MAX_FILE_MB=1024
MAX_JOB_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=300

# Rate limiting (per IP)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=60

# External tools
FFMPEG_PATH=ffmpeg
YTDLP_SOCKET_TIMEOUT=30

# Optional admin/debug dashboard (off by default)
ENABLE_ADMIN=false
ADMIN_TOKEN=
